<?xml version="1.0" encoding="utf-8"?>
<!--
    plurals.xml  →  res/values/plurals.xml
    (copiar también a res/values-es/plurals.xml con las traducciones en español)
-->
<resources>
    <!--
        Usado en FiltersFragment para mostrar "1 product" / "12 products"
        %d se sustituye por el número en getQuantityString(R.plurals.results_count, count, count)
    -->
    <plurals name="results_count">
        <item quantity="one">%d product</item>
        <item quantity="other">%d products</item>
    </plurals>
</resources>
