<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ══════════════════════════════════════════════
        PERMISOS DE RED — para futura conexión MySQL
        vía WiFi local (puerto 3306)
        ══════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ══════════════════════════════════════════════
        PERMISOS DE ALMACENAMIENTO — lectura/escritura
        de ficheros JSON en almacenamiento interno.
        NOTA: En Android 10+ usamos context.getFilesDir()
        que no requiere permisos. Estos son para storage
        externo (Downloads, SD) si se necesitase en el futuro.
        ══════════════════════════════════════════════ -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/warehouse_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/warehouse_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WareHouse13"
        android:usesCleartextTraffic="true">
        <!--
            android:usesCleartextTraffic="true" es necesario para conectar
            a MySQL local por HTTP plano (sin TLS). En producción se usaría
            HTTPS y esto debería ser false.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
